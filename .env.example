MAX_FLASH_FEE_BPS=5

# --- 5. BILLING & MONETIZATION ---
STRIPE_API_KEY=sk_live_REPLACE_WITH_RUNTIME_ENV

# --- 6. OSINT & PROPERTY DATA PROVIDERS ---
